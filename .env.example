# RAG Assistant — environment variables
#
# LLM credentials are injected here so the deployment can rotate keys
# without touching the running app or the keyring.

# ---- LLM (Anthropic-compatible endpoint, e.g. a MiniMax proxy) ----
MINIMAX_API_KEY=your-MiniMax-api-key-here
# MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
# MINIMAX_MODEL=MiniMax-M3

# ---- Server (optional overrides) ----
# RAG_HOST=127.0.0.1
# RAG_PORT=8765

# ---- Logging ----
# RAG_LOG_LEVEL=INFO

# ---- Keyring service name (fallback only — used when MINIMAX_API_KEY is unset) ----
# RAG_KEYRING_SERVICE=rag_assistant

# ---- Custom user data directory (default: ~/.rag_assistant) ----
# RAG_DATA_DIR=/path/to/data

# ---- In-app provider/model defaults (overridden by Settings dialog) ----
# RAG_LLM_PROVIDER=anthropic
# RAG_LLM_MODEL=MiniMax-M3
